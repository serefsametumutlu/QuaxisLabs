# Bilanco Radar - ortam degiskenleri sablonu
# Bu dosyayi .env olarak kopyala ve kendi anahtarlarini gir. .env asla repoya eklenmez.

# Google Gemini API anahtari (sozel analiz uretimi icin, aistudio.google.com)
GEMINI_API_KEY=

# Telegram bot token (BotFather'dan alinir)
TELEGRAM_BOT_TOKEN=

# Loglama seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SQLite veritabani dosya yolu (varsayilan: data/bilanco_radar.db)
DATABASE_URL=sqlite:///data/bilanco_radar.db

# Dis servis istekleri icin ayarlar
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_RATE_LIMIT_DELAY_SECONDS=1.0

# KAP bildirimlerinde geriye donuk kac gun taransin
KAP_LOOKBACK_DAYS=90

# Gemini model adi -- flash-lite-latest, flash-latest'ten AYRI (ve
# gozlemlenen kullanimda daha yuksek) gunluk kotaya sahip; ucretsiz katman
# kotasi (RESOURCE_EXHAUSTED / 429) hala sik yasaniyorsa GEMINI_API_KEY'in
# baglantili oldugu Google Cloud projesinde faturalandirma acmak kotayi
# kalici olarak yukseltir.
GEMINI_MODEL=gemini-flash-lite-latest
