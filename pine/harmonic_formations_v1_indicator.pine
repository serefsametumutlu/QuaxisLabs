// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © serefsamett — Harmonic Formations V2.2 (Gartley / Bat / Butterfly / Crab / ABCD), INDICATOR
//
// `pine/abcd_v2_5_indicator.pine`nin (bilanco-radar/QuaxisLabs "Formasyonlar"
// ozelligi Faz 0-10 arastirmasinin kaynagi) pivot state machine cekirdegini
// korur. Bu dosyanin gecmisi: V1 (4 formasyon ayni noktada tetikleniyordu,
// COK genis/ortusen bantlar) -> V2.1 (X noktasi + BC-goreli CD + XD/XA +
// dogru yon duzeltmesi, ARTI opsiyonel/ikincil bir "PRZ erken uyari" katmani,
// varsayilan KAPALI) -> **V2.2 (bu surum)**.
//
// V2.2 KESIN KULLANICI KARARI (2026-08-18): "her formasyon icin lookback
// tamamen 0 olmali, C onaylandiktan sonra istatistiksel D bolgesine fiyat
// GIRER GIRMEZ sinyal anlik gorunmeli, 3-5 mum SONRA degil." Onceki V2.1'de
// onayli D sinyali HER ZAMAN D'nin kendisinden `pivot_lookback` bar SONRA
// geliyordu (ta.pivothigh/low'un dogasi geregi) -- bu arada fiyat cogu zaman
// TP1'e ulasip donuyordu. V2.2 bunu KOKTEN degistirir: eski "PRZ" projeksiyon
// katmani (onceden ikincil/opsiyonel) artik TEK ve ANA sinyal mekanizmasidir.
//
// NASIL CALISIR: X-A-B-C noktalari HALA `pivot_lookback` kadar onay bekler
// (bu matematiksel bir zorunluluk -- bir pivotun GERCEKTEN pivot oldugu
// ancak sonrasi gorulunce bilinir, DEGISTIRILEMEZ). Ama D icin ARTIK AYRI
// bir pivot onayi BEKLENMEZ: X-A-B-C onaylanir onaylanmaz, D'nin Fibonacci
// matematigine gore OLMASI gereken fiyat bolgesi (CD/BC + XD/XA
// projeksiyonlarinin KESISIMI -- gercek harmonik tarayicilarin "PRZ" ilkesi)
// hesaplanir; fiyat bu bolgeye CANLI (mum kapanmadan, `barstate.isconfirmed`
// DISINDA) girdigi ANDA D sinyali (tam ucgen cizimi + TP1/TP2/SL + alert)
// ANINDA verilir.
//
// BILINCLI ODUN (kullaniciya acikca soylenmis, ONAYLANMIS karar): bu sinyal
// REPAINT EDEBILIR -- fiyat bolgeye deyip formasyonu hic TAMAMLAMADAN devam
// edebilir, cunku D artik "gercekten bir pivot oldugu once/sonra dogrulanmis"
// bir nokta DEGIL, sadece "fiyat matematiksel hedefe ulasti" anidir. Bu,
// projenin genelindeki "asla look-ahead/repaint yok" ilkesinden BILEREK,
// kullanici talebiyle sapma -- geriye donuk "onayli, repaint'siz" mod
// istenirse `pivot_lookback`u ARTIRIP fiyatin bolgeye NE KADAR ERKEN
// girdigini gormek yerine formasyonun TAMAMLANMASINI beklemek gerekir (bu
// artik bu script'te bir secenek olarak SUNULMUYOR, kullanici acikca "3-5
// mum sonra degil, anlik" istedi).
//
// Formasyon on-ayarlarinin matematiksel gerekcesi (BC/AB bandi, CD/BC
// oranlari, XD/XA hedefleri) ve "ayni pivot birden fazla aileyle eslesebilir"
// notu DEGISMEDI -- bkz. `src/analysis/harmonic_presets.py` ve
// `src/analysis/harmonic_xabcd.py` (Python tarafi, henuz bu V2.2 anlik-
// sinyal mantigina TASINMADI -- SADECE TradingView manuel dogrulama icin).

// V2.3 EKLENTISI (2026-08-19, kullanici istegi -- "Harmonik Formasyonlar
// Gelistirilmis Teknik Analiz Raporu"): D noktasinda 4 ONAY kontrolu
// (RSI uyumsuzluk/asiri-bolge-donusu, MACD histogram donus yonu, mum
// paterni Pin Bar/Engulfing, hacim sikisma+patlama) artik HESAPLANIR ve
// D etiketinde/alert'te gosterilir -- Python karsiligi `src/analysis/
// harmonic_confirmation.py` ile AYNI mantik (RSI/MACD Pine yerlesik
// `ta.rsi`/`ta.macd` kullanir, Python'un `_rsi_wilder`/`_macd_hist`
// fonksiyonlariyla Pine-parity ZORUNLU DEGIL -- `abcd_factor_analysis.
// _adx_wilder` docstring'indeki AYNI gerekce: bu, cekirdek XABCD tespit
// motoru DEGIL, bir ONAY/baglam katmani). HICBIRI sinyali FILTRELEMEZ,
// SADECE bilgilendirir (proje ilkesi, harmonic_scanner.py ile AYNI).
//
// TP2 TANIMI DEGISTI: eskiden C seviyesiydi, artik 0.618 Altin Oran (AD
// bacaginin 61.8'i) -- kullanici karari, Python tarafi (`harmonic_xabcd.py`)
// ile AYNI committe LOCKSTEP guncellendi.
//
// V2.3 DUZELTME (2026-08-19, kullanici geri bildirimi): onay detayi ARTIK
// D etiketine YAZILMIYOR -- D etiketi SADECE "{Formasyon} BUY/SELL" (baska
// hicbir sey). Onay kontrol listesi (RSI/MACD/Mum/Hacim + skor + D fiyati)
// SAG UST kosede AYRI bir tabloda (`confTable`) gosterilir, her yeni D
// sinyalinde uzerine yazilir (en son sinyali gosterir, gecmis biriktirmez).

//@version=6
indicator("Harmonic Formations V2.3 (Gartley/Bat/Butterfly/Crab/ABCD)", shorttitle="Harmonic V2.3",
     overlay=true, max_lines_count=500, max_labels_count=500, max_polylines_count=100)

// ══════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════
var string GRP_FORM = "Formation"
var string GRP_CORE = "Core Detection"
var string GRP_CUST = "Custom bantlar (sadece 'Custom' secilirse kullanilir)"
var string GRP_VIZ  = "Visual & UX Settings"

formation = input.string("Crab", "Formation Preset",
     options=["ABCD (exact 1.0)", "Gartley", "Bat", "Butterfly", "Crab", "Custom"],
     tooltip="Gartley/Bat/Butterfly/Crab 5-noktali (X-A-B-C-D) literatur-dogru tanim kullanir: " +
             "CD/BC bandi + XD/XA tamamlanma orani. ABCD ve Custom eski AB-goreli CD tanimini " +
             "korur. 'ABCD (exact 1.0)' secilirse, klasik AB=CD gostergeleriyle (orn. Advanced " +
             "AB=CD Harmonic PRO) AYNI matematigi kullanir -- Crab/Gartley/Bat/Butterfly cok DAHA " +
             "SIKI/nadir kosullardir, bu YUZDEN cok daha az sinyal verir (bug degil, kasitli).",
     group=GRP_FORM)

// pivot_lookback SADECE X/A/B/C pivotlarinin ONAYINI etkiler (bu asla 0
// olamaz -- bir pivotun pivot oldugunu bilmenin matematiksel tek yolu budur).
// D ARTIK bu bekelemeye tabi DEGIL (bkz. dosya ust notu V2.2).
pivot_lookback = input.int  (5,     "Pivot Lookback Period (SADECE X/A/B/C icin)", minval=2,     maxval=20,              group=GRP_CORE)
fib_tolerance  = input.float(0.05,  "Fibonacci Tolerance (ε)",           minval=0.01,  maxval=0.20, step=0.01, group=GRP_CORE)
atr_mult       = input.float(1.0,   "ATR SL Multiplier",                 minval=0.5,   maxval=5.0,  step=0.1,  group=GRP_CORE)
enable_long    = input.bool (true,  "Enable Long (Bullish) Patterns",                                          group=GRP_CORE)
enable_short   = input.bool (true,  "Enable Short (Bearish) Patterns",                                         group=GRP_CORE)

cust_min_bc_retrace = input.float(0.382, "Min BC/AB Retracement",              minval=0.236, maxval=0.886,           group=GRP_CUST)
cust_max_bc_retrace = input.float(0.886, "Max BC/AB Retracement",              minval=0.236, maxval=0.886,           group=GRP_CUST)
cust_use_exact_cd   = input.bool (true,  "Use Exact 1.000 CD Extension",                                             group=GRP_CUST)
cust_cd_min_ext     = input.float(0.886, "Min CD/AB Extension (if not exact)", minval=0.3,   maxval=4.0,             group=GRP_CUST)
cust_cd_max_ext     = input.float(1.272, "Max CD/AB Extension (if not exact)", minval=0.3,   maxval=4.0,             group=GRP_CUST)

bull_color  = input.color(color.lime, "Bullish Color",                                                         group=GRP_VIZ)
bear_color  = input.color(color.red,  "Bearish Color",                                                         group=GRP_VIZ)
fill_transp = input.int  (90,  "Fill Transparency (70-99)",               minval=70, maxval=99,                group=GRP_VIZ)
show_labels = input.bool (true, "Show TP/SL Labels",                                                           group=GRP_VIZ)
tp_sl_bars  = input.int  (20,  "TP/SL Line Length (bars)",                minval=5,  maxval=100,               group=GRP_VIZ)
show_zone_box = input.bool(true, "D bolgesi beklenirken kutu goster",                                          group=GRP_VIZ)

var string GRP_CONF = "Onay Kontrol Listesi (RSI/MACD/Mum/Hacim)"
show_confirmation = input.bool(true, "D etiketinde onay kontrol listesini goster", group=GRP_CONF)
rsi_oversold      = input.float(30.0, "RSI Asiri Satim Esigi",  minval=10, maxval=40, group=GRP_CONF)
rsi_overbought    = input.float(70.0, "RSI Asiri Alim Esigi",   minval=60, maxval=90, group=GRP_CONF)
vol_expansion_mult = input.float(1.2, "Hacim Patlama Katsayisi (SMA20'ye gore)", minval=1.0, maxval=3.0, step=0.1, group=GRP_CONF)
vol_compression_ratio = input.float(0.85, "Hacim Sikisma Orani (son 5 bar / onceki 15 bar)", minval=0.3, maxval=1.0, step=0.05, group=GRP_CONF)

// ══════════════════════════════════════════════════════════
// FORMATION PRESET -> bantlar
// ══════════════════════════════════════════════════════════
is_xabcd = formation == "Gartley" or formation == "Bat" or formation == "Butterfly" or formation == "Crab"

eff_min_bc_retrace = formation == "Custom" ? cust_min_bc_retrace : 0.382
eff_max_bc_retrace = formation == "Custom" ? cust_max_bc_retrace : 0.886

eff_use_exact_cd = formation == "ABCD (exact 1.0)" ? true : formation == "Custom" ? cust_use_exact_cd : true
eff_cd_min_ext   = formation == "Custom" ? cust_cd_min_ext : 0.886
eff_cd_max_ext   = formation == "Custom" ? cust_cd_max_ext : 1.272

eff_cd_bc_min = formation == "Gartley" ? 1.272 : formation == "Bat" ? 1.618 : formation == "Butterfly" ? 1.618 : formation == "Crab" ? 2.24 : 1.272
eff_cd_bc_max = formation == "Gartley" ? 1.618 : formation == "Bat" ? 2.618 : formation == "Butterfly" ? 2.24  : formation == "Crab" ? 3.618 : 1.618

eff_xd_target = formation == "Gartley" ? 0.786 : formation == "Bat" ? 0.886 : formation == "Butterfly" ? 1.27 : formation == "Crab" ? 1.618 : 0.786

// ══════════════════════════════════════════════════════════
// ROLLING 4-PIVOT STATE (X-A-B-C) — D artik burada TUTULMUYOR, ANLIK
// hesaplanip aninda sinyale donusuyor (bkz. dosya ust notu V2.2).
// ══════════════════════════════════════════════════════════
var float pX_price = na
var int   pX_bar   = -1
var int   pX_type  = 0
var float pA_price = na
var int   pA_bar   = -1
var int   pA_type  = 0
var float pB_price = na
var int   pB_bar   = -1
var int   pB_type  = 0
var float pC_price = na
var int   pC_bar   = -1
var int   pC_type  = 0
var int   last_ptype = 0

// RSI uyumsuzluk taban noktasi (B) icin, B PIVOTUNUN OLUSTUGU bardaki RSI --
// `harmonic_confirmation.py`nin b_bar/b_price ile AYNI ilke (bkz. GRP_CONF).
var float pB_rsi = na
var float pC_rsi = na

// D bolgesi durumu -- hangi C icin zaten sinyal verildigini/kutu cizildigini
// izler (ayni C icin tekrar tekrar sinyal/kutu URETILMEZ).
var box  dZoneBox     = na
var bool dAlertedForC = false
var int  dActiveCBar  = -2

// Onay kontrol listesi tablosu -- SAG UST kose, kullanici karari (2026-08-19):
// "hangi sartin saglandigi/saglanmadigi D etiketine DEGIL, ayri bir tabloya
// yazilsin". Satirlar SADECE en SON D sinyalinde guncellenir (var table --
// bar bar YENIDEN OLUSTURULMEZ, hucreler ustune yazilir).
var table confTable = table.new(position.top_right, 2, 6, border_width=1, frame_width=1)

// ══════════════════════════════════════════════════════════
// PATTERN VALIDATION -- X-A-B-C icin yapisal siralama + BC oran kontrolu.
// ("D icindeki" strict kontrol -- eskiden `d_p < b_p` -- artik burada YOK,
// D henuz bir pivot DEGIL; bu D olustugunda ayrica dogrulanir, bkz. asagida
// `d_valid` -- ayni katilik, sadece D artik canli/projekte edilen bir fiyat.)
// ══════════════════════════════════════════════════════════
bcOk(a_p, b_p, c_p, is_bearish) =>
    ab = math.abs(b_p - a_p)
    bc = math.abs(c_p - b_p)
    // A-B-C yapisal siralamasi: bearish'te A<C<B, bullish'te A>C>B (eski
    // `isValidHarmonic`deki `strct`in D-BAGIMSIZ yarisi -- BC orani TEK
    // BASINA C'nin A ile B ARASINDA kaldigini GARANTI ETMEZ, bkz. commit notu).
    strct = is_bearish ? (a_p < c_p and c_p < b_p) : (a_p > c_p and c_p > b_p)
    strct and ab > 0.0 and (bc / ab) >= eff_min_bc_retrace - fib_tolerance and (bc / ab) <= eff_max_bc_retrace + fib_tolerance

// ══════════════════════════════════════════════════════════
// SERIES
// ══════════════════════════════════════════════════════════
ph    = ta.pivothigh(high, pivot_lookback, pivot_lookback)
pl    = ta.pivotlow (low,  pivot_lookback, pivot_lookback)
atr14 = ta.atr(14)

// ── Onay kontrol listesi serileri (bkz. GRP_CONF, harmonic_confirmation.py ile AYNI mantik) ──
rsi14 = ta.rsi(close, 14)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
volSma20    = ta.sma(volume, 20)
volRecent5  = ta.sma(volume, 5)[1]   // D'den ONCEKI 5 barin ortalamasi (bkz. harmonic_confirmation.py _VOL_COMPRESSION_LOOKBACK)
volBaseline15 = ta.sma(volume, 15)[6]  // ondan onceki 15 bar

isBullishPinBar(o, h, l, c) =>
    rng = h - l
    body = math.abs(c - o)
    lowerWick = math.min(o, c) - l
    upperWick = h - math.max(o, c)
    rng > 0 and lowerWick >= 2.0 * body and upperWick <= body and c >= (l + 0.5 * rng)

isBearishPinBar(o, h, l, c) =>
    rng = h - l
    body = math.abs(c - o)
    upperWick = h - math.max(o, c)
    lowerWick = math.min(o, c) - l
    rng > 0 and upperWick >= 2.0 * body and lowerWick <= body and c <= (h - 0.5 * rng)

isBullishEngulfing(prevO, prevC, o, c) =>
    c > o and prevC < prevO and c >= prevO and o <= prevC

isBearishEngulfing(prevO, prevC, o, c) =>
    c < o and prevC > prevO and c <= prevO and o >= prevC

sig_buy  = false
sig_sell = false

// ══════════════════════════════════════════════════════════
// STEP 1 — X/A/B/C pivot alimi (kesin alternans). SADECE bu adim
// `barstate.isconfirmed` icinde -- rolling state bar basina TEK KEZ
// kaymali, canli tick'lerde TEKRAR TEKRAR degil.
// ══════════════════════════════════════════════════════════
if barstate.isconfirmed
    new_price = float(na)
    new_bar   = int(na)
    new_type  = 0

    if not na(ph) and last_ptype != 1
        new_price := ph
        new_bar   := bar_index - pivot_lookback
        new_type  := 1
    else if not na(pl) and last_ptype != -1
        new_price := pl
        new_bar   := bar_index - pivot_lookback
        new_type  := -1

    if new_type != 0
        pX_price   := pA_price
        pX_bar     := pA_bar
        pX_type    := pA_type
        pA_price   := pB_price
        pA_bar     := pB_bar
        pA_type    := pB_type
        pB_price   := pC_price
        pB_bar     := pC_bar
        pB_type    := pC_type
        pB_rsi     := pC_rsi
        pC_price   := new_price
        pC_bar     := new_bar
        pC_type    := new_type
        pC_rsi     := rsi14[pivot_lookback]  // pivotun GERCEKTEN olustugu bardaki RSI (biz simdi pivot_lookback bar SONRASINDAYIZ)
        last_ptype := new_type

// ══════════════════════════════════════════════════════════
// STEP 2 — D BOLGESI + ANLIK SINYAL (`barstate.isconfirmed` DISINDA --
// her tick'te canli calisir, mum kapanmasini BEKLEMEZ). Onayli X-A-B-C
// icin D'nin Fibonacci matematigine gore OLMASI gereken fiyat bolgesini
// hesaplar; fiyat bu bolgeye deydigi ANDA tam sinyali (ucgen + TP/SL +
// alert) uretir -- bkz. dosya ust notu V2.2.
// ══════════════════════════════════════════════════════════
valid_pending = not na(pA_price) and not na(pB_price) and not na(pC_price)
ab2 = valid_pending ? math.abs(pB_price - pA_price) : float(na)
bc2 = valid_pending ? math.abs(pC_price - pB_price) : float(na)
xa2 = (is_xabcd and not na(pX_price)) ? math.abs(pA_price - pX_price) : float(na)

is_bear = pC_type == -1  // C bir DIP ise beklenen D bir TEPE -> SHORT kurulumu
dir_ok  = (is_bear and enable_short) or ((not is_bear) and enable_long)
x_type_ok = not is_xabcd or (is_bear ? pX_type == 1 : pX_type == -1)

bc_ok = valid_pending and bcOk(pA_price, pB_price, pC_price, is_bear)

zone_low  = float(na)
zone_high = float(na)

if valid_pending and bc_ok and dir_ok and x_type_ok and bc2 > 0
    cd_lo = float(na)
    cd_hi = float(na)
    if is_xabcd
        if is_bear
            cd_lo := pC_price + (eff_cd_bc_min - fib_tolerance) * bc2
            cd_hi := pC_price + (eff_cd_bc_max + fib_tolerance) * bc2
        else
            cd_lo := pC_price - (eff_cd_bc_max + fib_tolerance) * bc2
            cd_hi := pC_price - (eff_cd_bc_min - fib_tolerance) * bc2
    else
        cd_min_use = eff_use_exact_cd ? (1.0 - fib_tolerance) : (eff_cd_min_ext - fib_tolerance)
        cd_max_use = eff_use_exact_cd ? (1.0 + fib_tolerance) : (eff_cd_max_ext + fib_tolerance)
        if is_bear
            cd_lo := pC_price + cd_min_use * ab2
            cd_hi := pC_price + cd_max_use * ab2
        else
            cd_lo := pC_price - cd_max_use * ab2
            cd_hi := pC_price - cd_min_use * ab2

    if is_xabcd and not na(xa2) and xa2 > 0
        xd_center = is_bear ? pA_price + eff_xd_target * xa2 : pA_price - eff_xd_target * xa2
        xd_half   = fib_tolerance * xa2
        zone_low  := math.max(cd_lo, xd_center - xd_half)
        zone_high := math.min(cd_hi, xd_center + xd_half)
    else
        zone_low  := cd_lo
        zone_high := cd_hi

zone_valid = not na(zone_low) and not na(zone_high) and zone_low <= zone_high

// Aktif C degistiyse (yeni bir X/A/B/C pivotu onaylandi) -- eski kutu/
// sinyal durumunu SIFIRLA, yeni beklenti icin bastan basla.
if pC_bar != dActiveCBar
    if not na(dZoneBox)
        box.delete(dZoneBox)
    dZoneBox      := na
    dAlertedForC  := false
    dActiveCBar   := pC_bar

if zone_valid and show_zone_box and not dAlertedForC
    if na(dZoneBox)
        dZoneBox := box.new(pC_bar, zone_high, bar_index, zone_low,
             border_color=color.orange, border_width=1, bgcolor=color.new(color.orange, 88),
             text="D bolgesi (" + formation + ")", text_color=color.orange, text_size=size.tiny)
    else
        box.set_right(dZoneBox, bar_index)
        box.set_top(dZoneBox, zone_high)
        box.set_bottom(dZoneBox, zone_low)
else if not zone_valid and not na(dZoneBox)
    box.delete(dZoneBox)
    dZoneBox := na

if zone_valid and not dAlertedForC
    entered = low <= zone_high and high >= zone_low
    // Yapisal D kontrolu (eski `isValidHarmonic`deki `d_p < b_p`/`d_p > b_p`
    // yarisi -- D, B'nin ARKASINDA/OTESINDE kalmali, C'ye cok yakin bir
    // "sahte" bolge eslesmesi OLMAMALI). Bolgenin ilk deydigi kenar
    // (zone_high uzun/zone_low kisa icin) test edilir.
    d_candidate = is_bear ? zone_high : zone_low
    d_structurally_ok = is_bear ? d_candidate > pB_price : d_candidate < pB_price
    if entered and d_structurally_ok
        dAlertedForC := true
        if not na(dZoneBox)
            box.delete(dZoneBox)
            dZoneBox := na

        d_price     = is_bear ? zone_high : zone_low  // bolgeye ILK deydigi kenar (fiyat yonunun geldigi taraf)
        d_bar       = bar_index
        entry_price = close

        ad_range = math.abs(pA_price - d_price)
        tp1      = is_bear ? d_price - ad_range * 0.382 : d_price + ad_range * 0.382
        tp2      = is_bear ? d_price - ad_range * 0.618 : d_price + ad_range * 0.618
        sl       = is_bear ? d_price + atr_mult * atr14 : d_price - atr_mult * atr14

        // ── Onay kontrol listesi (bkz. GRP_CONF / harmonic_confirmation.py) ──
        rsiDivergence  = na(pB_rsi) ? false : (is_bear ? d_price > pB_price and rsi14 < pB_rsi : d_price < pB_price and rsi14 > pB_rsi)
        rsiExtremeTurn = is_bear ? (rsi14 >= rsi_overbought and rsi14 < rsi14[1]) : (rsi14 <= rsi_oversold and rsi14 > rsi14[1])
        rsiOk   = rsiDivergence or rsiExtremeTurn
        macdOk  = is_bear ? macdHist < macdHist[1] : macdHist > macdHist[1]
        pinBar  = is_bear ? isBearishPinBar(open, high, low, close) : isBullishPinBar(open, high, low, close)
        engulf  = is_bear ? isBearishEngulfing(open[1], close[1], open, close) : isBullishEngulfing(open[1], close[1], open, close)
        candleOk = pinBar or engulf
        candleLbl = pinBar ? "PinBar" : engulf ? "Engulf" : "Yok"
        volRatio = volSma20 > 0 ? volume / volSma20 : float(na)
        volExpansion   = not na(volRatio) and volRatio >= vol_expansion_mult
        volCompression = volBaseline15 > 0 and volRecent5 < vol_compression_ratio * volBaseline15
        volOk = volExpansion and volCompression
        confScore = (rsiOk ? 1 : 0) + (macdOk ? 1 : 0) + (candleOk ? 1 : 0) + (volOk ? 1 : 0)
        confText = "RSI:" + (rsiOk ? "OK" : "x") + " MACD:" + (macdOk ? "OK" : "x") +
             " Mum:" + candleLbl + " Hacim:" + (volOk ? "OK" : "x") + " [" + str.tostring(confScore) + "/4]"

        base_col = is_bear ? bear_color : bull_color

        // ── Onay tablosu (SAG UST) -- D etiketi ARTIK sadece formasyon+yon,
        // detay burada (bkz. GRP_CONF / kullanici karari 2026-08-19) ──────
        if show_confirmation
            ok_col  = color.new(color.teal, 0)
            bad_col = color.new(color.gray, 40)
            table.cell(confTable, 0, 0, formation + (is_bear ? " SELL" : " BUY"), text_color=color.white, bgcolor=base_col, text_size=size.small)
            table.cell(confTable, 1, 0, "[" + str.tostring(confScore) + "/4]", text_color=color.white, bgcolor=base_col, text_size=size.small)
            table.cell(confTable, 0, 1, "RSI", text_color=color.gray, text_size=size.small)
            table.cell(confTable, 1, 1, rsiOk ? "✓" : "✕", text_color=rsiOk ? ok_col : bad_col, text_size=size.small)
            table.cell(confTable, 0, 2, "MACD", text_color=color.gray, text_size=size.small)
            table.cell(confTable, 1, 2, macdOk ? "✓" : "✕", text_color=macdOk ? ok_col : bad_col, text_size=size.small)
            table.cell(confTable, 0, 3, "Mum", text_color=color.gray, text_size=size.small)
            table.cell(confTable, 1, 3, candleOk ? candleLbl : "✕", text_color=candleOk ? ok_col : bad_col, text_size=size.small)
            table.cell(confTable, 0, 4, "Hacim", text_color=color.gray, text_size=size.small)
            table.cell(confTable, 1, 4, volOk ? "✓" : "✕", text_color=volOk ? ok_col : bad_col, text_size=size.small)
            table.cell(confTable, 0, 5, "D fiyatı", text_color=color.gray, text_size=size.small)
            table.cell(confTable, 1, 5, str.tostring(d_price, format.mintick), text_color=color.silver, text_size=size.small)
        fill_col = color.new(is_bear ? color.red : color.green, fill_transp)
        line_col = color.new(base_col, 10)
        lbl_col  = color.new(base_col, 20)
        x_end    = d_bar + tp_sl_bars

        if is_xabcd
            polyline.new(
                 array.from(chart.point.from_index(pX_bar, pX_price),
                             chart.point.from_index(pA_bar, pA_price),
                             chart.point.from_index(pB_bar, pB_price)),
                 closed=true, fill_color=fill_col, line_color=line_col, line_width=1)
            label.new(pX_bar, pX_price, "X",
                      style     = pX_type == 1 ? label.style_label_down : label.style_label_up,
                      color     = color.new(base_col, 75),
                      textcolor = lbl_col, size=size.small)

        polyline.new(
             array.from(chart.point.from_index(pA_bar, pA_price),
                         chart.point.from_index(pB_bar, pB_price),
                         chart.point.from_index(pC_bar, pC_price)),
             closed=true, fill_color=fill_col, line_color=line_col, line_width=1)
        polyline.new(
             array.from(chart.point.from_index(pB_bar, pB_price),
                         chart.point.from_index(pC_bar, pC_price),
                         chart.point.from_index(d_bar, d_price)),
             closed=true, fill_color=fill_col, line_color=line_col, line_width=1)

        label.new(pA_bar, pA_price, "A",
                  style     = pA_type == 1 ? label.style_label_down : label.style_label_up,
                  color     = color.new(base_col, 75),
                  textcolor = lbl_col, size=size.small)
        label.new(pB_bar, pB_price, "B",
                  style     = pB_type == 1 ? label.style_label_down : label.style_label_up,
                  color     = color.new(base_col, 75),
                  textcolor = lbl_col, size=size.small)
        label.new(pC_bar, pC_price, "C",
                  style     = pC_type == 1 ? label.style_label_down : label.style_label_up,
                  color     = color.new(base_col, 75),
                  textcolor = lbl_col, size=size.small)

        // ── D sinyal etiketi (ANLIK -- mum kapanmadan). SADECE formasyon +
        // yon -- kullanici karari (2026-08-19): "baska bir sey yazmasin,
        // hangi formasyonda geldiyse o yazsin". Onay detayi confTable'da.
        label.new(d_bar, d_price,
                  formation + (is_bear ? " SELL" : " BUY"),
                  style     = is_bear ? label.style_label_down : label.style_label_up,
                  color     = line_col,
                  textcolor = color.white,
                  size      = size.normal)

        line.new(d_bar, entry_price, x_end, entry_price,
                 color=color.white, width=2, style=line.style_dashed)
        label.new(x_end, entry_price, "ENTRY",
                  style     = label.style_label_left,
                  color     = color.new(color.white, 60),
                  textcolor = color.white,
                  size      = size.small)

        line.new(d_bar, tp1, x_end, tp1, color=color.teal,                width=1, style=line.style_dashed)
        line.new(d_bar, tp2, x_end, tp2, color=color.new(color.green, 0), width=1, style=line.style_dashed)
        line.new(d_bar, sl,  x_end, sl,  color=color.new(color.red,   0), width=1, style=line.style_dashed)

        if show_labels
            label.new(x_end, tp1,
                      "TP1 38.2% AD  " + str.tostring(tp1, format.mintick),
                      style=label.style_label_left, color=color.new(color.teal,  70),
                      textcolor=color.white, size=size.small)
            label.new(x_end, tp2,
                      "TP2 61.8% AD  " + str.tostring(tp2, format.mintick),
                      style=label.style_label_left, color=color.new(color.green, 70),
                      textcolor=color.white, size=size.small)
            label.new(x_end, sl,
                      "SL ATR  " + str.tostring(sl, format.mintick),
                      style=label.style_label_left, color=color.new(color.red,   70),
                      textcolor=color.white, size=size.small)

        sig_buy  := not is_bear
        sig_sell := is_bear
        alert(formation + "|" + syminfo.ticker + "|" + timeframe.period + "|" +
              (is_bear ? "SELL" : "BUY") +
              "|D=" + str.tostring(d_price, format.mintick) +
              "|ENTRY=" + str.tostring(entry_price, format.mintick) +
              "|TP1=" + str.tostring(tp1, format.mintick) +
              "|TP2=" + str.tostring(tp2, format.mintick) +
              "|SL=" + str.tostring(sl, format.mintick) +
              "|" + confText,
              alert.freq_once_per_bar)

alertcondition(sig_buy,  "Harmonic BUY (anlik)",  "{{ticker}} {{interval}} — Harmonic BUY, D bolgesine anlik giris")
alertcondition(sig_sell, "Harmonic SELL (anlik)", "{{ticker}} {{interval}} — Harmonic SELL, D bolgesine anlik giris")
